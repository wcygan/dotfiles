if ! declare -F nix_direnv_version >/dev/null \
  && [ ! -f "${DIRENV_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/direnv}/direnvrc" ] \
  && [ ! -f "$HOME/.direnvrc" ]; then
  if [ -f "${XDG_STATE_HOME:-$HOME/.local/state}/nix/profile/share/nix-direnv/direnvrc" ]; then
    source "${XDG_STATE_HOME:-$HOME/.local/state}/nix/profile/share/nix-direnv/direnvrc"
  elif [ -f "$HOME/.nix-profile/share/nix-direnv/direnvrc" ]; then
    source "$HOME/.nix-profile/share/nix-direnv/direnvrc"
  fi
  _dotfiles_disallow_fallback=1
fi

# Reuse the nix-direnv cache directly while it is newer than every input. This
# skips nix-direnv's per-load version checks, wrapper rewrite, and status
# logging, which cost more than importing the environment. Any stale or missing
# piece falls through to `use flake`, which rebuilds the cache.
_dotfiles_import_cached_flake() {
  declare -F _nix_import_env >/dev/null || return 1
  local cache=(.direnv/flake-profile-*.rc) input
  [[ ${#cache[@]} -eq 1 && -f ${cache[0]} && -e ${cache[0]%.rc} ]] || return 1
  for input in .envrc flake.nix flake.lock; do
    [[ ${cache[0]} -nt $input ]] || return 1
  done
  watch_file flake.nix flake.lock "$HOME/.direnvrc" \
    "${DIRENV_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/direnv}/direnvrc"
  _nix_import_env "${cache[0]}"
}

if ! _dotfiles_import_cached_flake; then
  if [ -n "${_dotfiles_disallow_fallback:-}" ] \
    && declare -F nix_direnv_disallow_fallback >/dev/null; then
    nix_direnv_disallow_fallback 2>/dev/null
  fi
  use flake
fi
unset -f _dotfiles_import_cached_flake
unset _dotfiles_disallow_fallback

# Override Nix's DEVELOPER_DIR to use system Xcode tools
# Fixes "Platform key FamilyDisplayName" warning from old xcbuild
# See: https://github.com/jetify-com/devbox/issues/2754
if [ -d /Library/Developer/CommandLineTools ]; then
  export DEVELOPER_DIR=/Library/Developer/CommandLineTools
fi
