if ! declare -F nix_direnv_version >/dev/null \
  && [ ! -f "${DIRENV_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/direnv}/direnvrc" ] \
  && [ ! -f "$HOME/.direnvrc" ]; then
  if [ -f "${XDG_STATE_HOME:-$HOME/.local/state}/nix/profile/share/nix-direnv/direnvrc" ]; then
    source "${XDG_STATE_HOME:-$HOME/.local/state}/nix/profile/share/nix-direnv/direnvrc"
  elif [ -f "$HOME/.nix-profile/share/nix-direnv/direnvrc" ]; then
    source "$HOME/.nix-profile/share/nix-direnv/direnvrc"
  fi
  if declare -F nix_direnv_disallow_fallback >/dev/null; then
    nix_direnv_disallow_fallback 2>/dev/null
  fi
fi
use flake

# Override Nix's DEVELOPER_DIR to use system Xcode tools
# Fixes "Platform key FamilyDisplayName" warning from old xcbuild
# See: https://github.com/jetify-com/devbox/issues/2754
if [ -d /Library/Developer/CommandLineTools ]; then
  export DEVELOPER_DIR=/Library/Developer/CommandLineTools
fi
