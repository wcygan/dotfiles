# syntax=docker/dockerfile:1
# A pinned Nix fixture keeps this image from invoking a remote installer.
FROM nixos/nix:2.30.3 AS nix-fixture

FROM fedora:43

ARG USER=tester
ARG UID=1000
ARG GID=1000

RUN dnf -y install \
      bash ca-certificates coreutils findutils git make procps-ng sudo && \
    dnf clean all && \
    groupadd --gid "${GID}" "${USER}" && \
    useradd --create-home --uid "${UID}" --gid "${GID}" --shell /bin/bash "${USER}" && \
    echo "${USER} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/99-${USER}"

# The fixture supplies Nix; this Dockerfile must never run the remote installer.
COPY --from=nix-fixture /nix /nix
COPY --from=nix-fixture /etc/nix /etc/nix

RUN chown -R "${USER}:${USER}" /nix

USER ${USER}
WORKDIR /home/${USER}/app

ENV NIX_REMOTE=local
ENV PATH="/home/${USER}/.nix-profile/bin:/nix/var/nix/profiles/default/bin:${PATH}"

COPY --chown=${USER}:${USER} . .

# Keep the cold install in its own cacheable layer so test-only changes do not
# rebuild the entire Nix profile.
RUN ./bootstrap.sh install

RUN nix --extra-experimental-features "nix-command flakes" develop --no-write-lock-file .#default --command \
      uv run --locked pytest && \
    fish -lc './tests/docker-test-commands.fish'

# Warm path: the same setup operation must be idempotent.
RUN ./bootstrap.sh install && ./bootstrap.sh doctor

CMD ["/bin/bash"]
