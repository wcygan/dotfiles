# syntax=docker/dockerfile:1
# A pinned Nix fixture keeps this image from invoking a remote installer.
FROM nixos/nix:2.35.1@sha256:377d4887aca98f0dfa12971c1ea6d6a625a435d8b610d4c95a436843da6fbfd1 AS nix-fixture

FROM ubuntu:24.04@sha256:561618e2c15bf2397621dd04f96926663a3b5616c189cf7e38db7e82f5c538ea

ARG USER=tester
ARG UID=1001
ARG GID=1001

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      bash ca-certificates coreutils findutils git hostname make procps sudo && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid "${GID}" "${USER}" && \
    useradd --create-home --uid "${UID}" --gid "${GID}" --shell /bin/bash "${USER}" && \
    echo "${USER} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/99-${USER}"

# The fixture supplies Nix; this Dockerfile must never run the remote installer.
COPY --from=nix-fixture /nix /nix
COPY --from=nix-fixture /etc/nix /etc/nix

RUN chown -R "${USER}:${USER}" /nix

USER ${USER}
WORKDIR /home/${USER}/app

ENV NIX_REMOTE=local
ENV PATH="/home/${USER}/.nix-profile/bin:/nix/var/nix/profiles/default/bin:${PATH}"

COPY --chown=${USER}:${USER} bootstrap.sh flake.nix flake.lock pyproject.toml uv.lock rust-toolchain.toml README.md ./
COPY --chown=${USER}:${USER} src ./src
COPY --chown=${USER}:${USER} config ./config

# Keep the cold install in its own cacheable layer so test-only changes do not
# rebuild the entire Nix profile.
RUN ./bootstrap.sh install

# Warm path: the same setup operation must be idempotent.
RUN ./bootstrap.sh install && ./bootstrap.sh doctor && ./bootstrap.sh verify

CMD ["/bin/bash"]
