%% Requires a renderer that registers the "logos" and "simple-icons" Iconify packs.
%% DragonflyDB uses a database shape until a custom icon is registered.
%% Redpanda is shown as a Kafka-compatible broker until a custom icon is registered.
%%{init: {"theme": "base", "flowchart": {"curve": "basis", "nodeSpacing": 55, "rankSpacing": 80}}}%%
flowchart LR
    subgraph edge["Clients"]
        browser["Browser"]
    end

    subgraph app["Application Services"]
        direction LR
        api["API"]
        temporal@{ icon: "simple-icons:temporal", form: "rounded", label: "Temporal", pos: "b", h: 58 }
        worker["Workers"]
    end

    subgraph stream["Event Streaming"]
        broker@{ icon: "logos:kafka", form: "rounded", label: "Kafka or Redpanda", pos: "b", h: 62 }
    end

    subgraph analytics["Analytics"]
        direction TB
        flink@{ icon: "logos:apache-flink", form: "rounded", label: "Flink", pos: "b", h: 58 }
        spark@{ icon: "logos:apache-spark", form: "rounded", label: "Spark", pos: "b", h: 58 }
        hdfs@{ icon: "logos:hadoop", form: "rounded", label: "HDFS", pos: "b", h: 58 }
    end

    subgraph data["Operational Data"]
        direction TB
        postgres@{ icon: "logos:postgresql", form: "rounded", label: "Postgres", pos: "b", h: 58 }
        mysql@{ icon: "logos:mysql", form: "rounded", label: "MySQL", pos: "b", h: 58 }
        redis@{ icon: "logos:redis", form: "rounded", label: "Redis", pos: "b", h: 58 }
        dragonfly[("DragonflyDB")]
        tidb@{ icon: "simple-icons:tidb", form: "rounded", label: "TiDB", pos: "b", h: 58 }
    end

    browser --> api
    api -- "start workflow" --> temporal
    temporal -- "activity task" --> worker
    worker -- "events" --> broker
    broker -- "stream" --> flink
    broker -- "replay" --> spark
    flink -- "lake files" --> hdfs
    spark -- "batch reads" --> hdfs
    flink -- "serving upserts" --> tidb
    worker -- "writes" --> postgres
    api -- "cache" --> redis
    api -- "cache alternative" --> dragonfly
    mysql -- "replicate" --> tidb

    classDef service fill:#eef6ff,stroke:#2563eb,color:#0f172a
    classDef streamNode fill:#f5f3ff,stroke:#7c3aed,color:#0f172a
    classDef analyticsNode fill:#ecfeff,stroke:#0891b2,color:#0f172a
    classDef store fill:#fff7ed,stroke:#c2410c,color:#0f172a
    class api,temporal,worker service
    class broker streamNode
    class flink,spark,hdfs analyticsNode
    class postgres,mysql,redis,dragonfly,tidb store
