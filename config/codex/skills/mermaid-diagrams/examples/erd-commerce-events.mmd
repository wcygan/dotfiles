erDiagram
    CUSTOMER ||--o{ ORDER : places
    ORDER ||--o{ PAYMENT : authorizes
    ORDER ||--o{ OUTBOX_EVENT : emits
    OUTBOX_EVENT ||--o{ KAFKA_MESSAGE : publishes
    KAFKA_MESSAGE ||--o{ ORDER_PROJECTION : updates

    CUSTOMER {
        uuid id PK
        string email
        string status
    }

    ORDER {
        uuid id PK
        uuid customer_id FK
        string status
        decimal total
        timestamp created_at
    }

    PAYMENT {
        uuid id PK
        uuid order_id FK
        string provider
        string status
        decimal amount
    }

    OUTBOX_EVENT {
        uuid id PK
        uuid aggregate_id
        string event_type
        json payload
        timestamp published_at
    }

    KAFKA_MESSAGE {
        string topic
        int partition
        bigint offset
        string key
    }

    ORDER_PROJECTION {
        uuid order_id PK
        string customer_email
        string order_status
        decimal total
        timestamp updated_at
    }
