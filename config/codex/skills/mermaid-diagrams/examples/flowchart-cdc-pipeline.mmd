%%{init: {"theme": "base", "flowchart": {"curve": "basis", "nodeSpacing": 45, "rankSpacing": 65}}}%%
flowchart TB
    subgraph write["Write path"]
        user["User updates plan"] --> app["Application"]
        app -- "commit user row" --> pg[("Postgres users")]
    end

    subgraph capture["Change capture"]
        pg -- "WAL change" --> debezium["Debezium connector"]
        debezium -- "user.plan_changed" --> kafka[["Kafka topic"]]
    end

    subgraph read_model["Read model"]
        kafka --> projector["Projection worker"]
        projector -- "index document" --> search[("OpenSearch")]
        search --> read_api["Read API"]
        read_api --> ui["UI"]
    end

    projector -. "poison event" .-> dlq[["DLQ topic"]]
    pg -. "fallback read" .-> read_api

    classDef source fill:#dcfce7,stroke:#15803d,color:#052e16
    classDef stream fill:#e0f2fe,stroke:#0369a1,color:#082f49
    classDef derived fill:#fef3c7,stroke:#b45309,color:#451a03
    class pg source
    class kafka,dlq stream
    class search derived
