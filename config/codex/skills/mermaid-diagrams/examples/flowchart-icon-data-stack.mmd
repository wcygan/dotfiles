%% Requires a renderer that registers the "logos" and "simple-icons" Iconify packs.
flowchart LR
    api@{ icon: "logos:fastapi-icon", form: "rounded", label: "API", pos: "b", h: 58 }
    temporal@{ icon: "simple-icons:temporal", form: "rounded", label: "Temporal", pos: "b", h: 58 }
    kafka@{ icon: "logos:kafka", form: "rounded", label: "Kafka", pos: "b", h: 58 }
    postgres@{ icon: "logos:postgresql", form: "rounded", label: "Postgres", pos: "b", h: 58 }
    mysql@{ icon: "logos:mysql", form: "rounded", label: "MySQL", pos: "b", h: 58 }
    redis@{ icon: "logos:redis", form: "rounded", label: "Redis", pos: "b", h: 58 }
    tidb@{ icon: "simple-icons:tidb", form: "rounded", label: "TiDB", pos: "b", h: 58 }
    flink@{ icon: "logos:apache-flink", form: "rounded", label: "Flink", pos: "b", h: 58 }
    spark@{ icon: "logos:apache-spark", form: "rounded", label: "Spark", pos: "b", h: 58 }
    hdfs@{ icon: "logos:hadoop", form: "rounded", label: "HDFS", pos: "b", h: 58 }

    api -- "start workflow" --> temporal
    temporal -- "activity task" --> api
    api -- "write command" --> postgres
    api -- "cache lookup" --> redis
    postgres -- "outbox event" --> kafka
    mysql -- "CDC event" --> kafka
    kafka -- "stream process" --> flink
    flink -- "serve aggregate" --> tidb
    kafka -- "batch replay" --> spark
    spark -- "parquet" --> hdfs

    classDef path fill:#eef6ff,stroke:#2563eb,color:#0f172a
    classDef store fill:#fff7ed,stroke:#c2410c,color:#0f172a
    class api,temporal,kafka,flink,spark path
    class postgres,mysql,redis,tidb,hdfs store
